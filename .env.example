# Copy to .env (ignored by Git) and replace the placeholders. Never commit real values.

# Absolute host path of the owner workspace; mounted read-only at /workspace.
AGENT_RUNTIME_WORKSPACE=/absolute/path/to/workspace

# Absolute host path of the operator configuration (see deploy/runtime/config.example.json); mounted read-only.
AGENT_RUNTIME_CONFIG=/absolute/path/to/config.json

# The full tailnet DNS name Serve publishes, e.g. agent-runtime.your-tailnet.ts.net (no scheme).
AGENT_RUNTIME_PUBLIC_HOST=agent-runtime.your-tailnet.ts.net

# URL-safe password for the private PostgreSQL service (letters and digits only).
POSTGRES_PASSWORD=replace-with-generated-password

# Tailnet machine name used for the Serve address.
TS_HOSTNAME=agent-runtime
