{
  "schema": "agent-runtime/kpwm-corpus-queries/1",
  "note": "The twenty-four golden QUESTIONS, with no answers. Mounted into both lanes with identical bytes, because a lane has to be asked in order to answer. The expected answers live in the oracle and are never mounted into a lane; the validator checks that every question here matches the oracle's copy of the same question exactly, so the two cannot drift into asking different things.",
  "defaults": { "maxStalenessMs": null, "onStale": "fail", "limit": 50, "maxDepth": 4 },
  "queries": [
    { "id": "Q01", "query": "CurrentClaims", "args": { "subject": "ent:halyard-auth" } },
    {
      "id": "Q02",
      "query": "ClaimsAsOf",
      "args": { "subject": "ent:halyard-auth", "predicate": "access_token_ttl" },
      "constraint": { "asOfValid": "2025-12-15T00:00:00.000Z" }
    },
    {
      "id": "Q03",
      "query": "ClaimsAsOf",
      "args": { "subject": "ent:halyard-api", "predicate": "rate_limit_per_minute" },
      "constraint": { "asOfValid": "2025-12-15T00:00:00.000Z" }
    },
    {
      "id": "Q04",
      "query": "BelievedAt",
      "args": { "subject": "ent:halyard-api", "predicate": "rate_limit_per_minute" },
      "constraint": { "asOfTransaction": "tick:45" }
    },
    {
      "id": "Q05",
      "query": "BelievedAt",
      "args": { "subject": "ent:halyard-api", "predicate": "rate_limit_per_minute" },
      "constraint": { "asOfTransaction": "tick:35" }
    },
    { "id": "Q06", "query": "Provenance", "args": { "ref": { "kind": "claim", "id": "clm:sum-flake" } } },
    {
      "id": "Q07",
      "query": "History",
      "args": { "ref": { "kind": "claim", "id": "clm:auth-ttl" }, "include": ["revision"] }
    },
    {
      "id": "Q08",
      "query": "Path",
      "args": { "to": "ent:tokenring", "relTypes": ["depends_on"], "direction": "inbound" },
      "constraint": { "asOfValid": "2026-01-05T00:00:00.000Z", "maxDepth": 4 }
    },
    {
      "id": "Q09",
      "query": "Path",
      "args": { "to": "ent:tokenring", "relTypes": ["depends_on"], "direction": "inbound" },
      "constraint": { "asOfValid": "2025-09-01T00:00:00.000Z", "maxDepth": 4 }
    },
    { "id": "Q10", "query": "Conflicts", "args": { "status": "open" } },
    { "id": "Q11", "query": "StaleDecisions", "args": {} },
    { "id": "Q12", "query": "Activity", "args": { "publisherNodeId": "node.bo" } },
    { "id": "Q13", "query": "CurrentClaims", "args": { "subject": "ent:kestrel-ingest" } },
    {
      "id": "Q14",
      "query": "Path",
      "args": {
        "from": "ent:northwind",
        "relTypes": ["employs"],
        "direction": "outbound",
        "resolveAliases": true
      },
      "constraint": { "maxDepth": 3 }
    },
    {
      "id": "Q15",
      "query": "CurrentClaims",
      "args": { "subject": "ent:halyard-alt", "resolveAliases": true }
    },
    { "id": "Q16", "query": "Provenance", "args": { "ref": { "kind": "claim", "id": "clm:rot-approach" } } },
    { "id": "Q17", "query": "Work", "args": { "workItemId": "wi:rotation" } },
    {
      "id": "Q18",
      "query": "Work",
      "args": { "workItemId": "wi:rotation", "constraintsInForceFor": "run:r3" }
    },
    { "id": "Q19", "query": "Provenance", "args": { "audit": "claims-without-evidence" } },
    { "id": "Q20", "query": "Provenance", "args": { "audit": "sensitive-canary-occurrences" } },
    {
      "id": "Q21",
      "query": "HybridRetrieve",
      "args": { "text": "why is the auth integration suite failing", "k": 10 }
    },
    { "id": "Q22", "query": "Work", "args": { "workItemId": "wi:rotation", "publishableTo": "peer" } },
    { "id": "Q23", "query": "Freshness", "args": { "scope": "all" } },
    { "id": "Q24", "query": "CurrentClaims", "args": { "subject": "ent:devi" } }
  ]
}
