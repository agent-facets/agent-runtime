{
  "name": "agent-runtime",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/runtime dev",
    "start": "bun run --cwd packages/runtime start",
    "build": "bun --no-env-file scripts/run-turbo.ts build",
    "check": "bun --no-env-file scripts/run-turbo.ts check",
    "check:verify": "bun --no-env-file scripts/run-turbo.ts check --force",
    "test": "bun --no-env-file scripts/run-turbo.ts test:all",
    "typecheck": "bun --no-env-file scripts/run-turbo.ts typecheck:all",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "test:scripts": "bun test ./scripts",
    "typecheck:scripts": "tsc -p tsconfig.json",
    "test:integration": "bun --no-env-file scripts/run-integration.ts",
    "test:container": "bun --no-env-file scripts/container-smoke.ts",
    "test:browser": "bun --no-env-file scripts/run-browser.ts",
    "test:facets": "bun --no-env-file scripts/run-facets.ts",
    "console:offline": "bun --no-env-file scripts/run-console-offline.ts",
    "acceptance:anthropic": "bun --no-env-file scripts/acceptance-anthropic.ts",
    "browser:install": "bun --bun node_modules/playwright/cli.js install chromium-headless-shell",
    "provenance:anthropic": "bun --no-env-file scripts/verify-anthropic-provenance.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@fission-ai/openspec": "1.13.2",
    "@types/bun": "1.3.14",
    "playwright": "1.63.0",
    "turbo": "2.10.4",
    "typescript": "5.9.3"
  }
}
