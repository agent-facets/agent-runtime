{
  "name": "agent-runtime",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/runtime dev",
    "start": "bun run --cwd packages/runtime start",
    "build": "TURBO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 turbo run build",
    "check": "TURBO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 turbo run check",
    "check:verify": "TURBO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 turbo run check --force",
    "test": "TURBO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 turbo run test:all",
    "typecheck": "TURBO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 turbo run typecheck:all",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "test:scripts": "bun test ./scripts",
    "typecheck:scripts": "tsc -p tsconfig.json",
    "test:integration": "bun --no-env-file scripts/run-integration.ts",
    "test:container": "bun --no-env-file scripts/container-smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@fission-ai/openspec": "1.13.2",
    "@types/bun": "1.3.14",
    "turbo": "2.10.4",
    "typescript": "5.9.3"
  }
}
