{
  "name": "@agent-runtime/runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/main.ts",
    "start": "bun dist/main.js",
    "build": "bun build src/main.ts src/auth.ts --target bun --production --root .. --entry-naming '[name].[ext]' --outdir dist && bun src/build/write-code-manifest.ts dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@agent-runtime/anthropic-subscription": "workspace:*",
    "@agent-runtime/contracts": "workspace:*",
    "@agent-runtime/ui": "workspace:*",
    "@anthropic-ai/sdk": "0.122.0",
    "@langchain/anthropic": "1.5.11",
    "@langchain/core": "1.2.13",
    "@langchain/langgraph": "1.4.13",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@langchain/langgraph-checkpoint-postgres": "1.0.5",
    "@langchain/openai": "1.6.0",
    "langchain": "1.5.14",
    "openai": "7.25.0",
    "pg": "8.16.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.15.6"
  }
}
